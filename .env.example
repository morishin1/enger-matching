# ENGER matching の環境変数サンプル
# 使い方:
#   1) このファイルを `.env.local` にコピー
#   2) 各キーの値を埋める（実値は Vercel 環境変数 / Supabase コンソールから取得）
#   3) `.env.local` は git 管理外（.gitignore 済）— コミットしないこと
#
# 種類:
#   NEXT_PUBLIC_* … ブラウザ側に露出する変数（公開鍵相当）
#   無印            … サーバ専用（service role key / API key など）

# ----------------------------------------
# Supabase（必須）
#   Project Settings → API から取得
# ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...（anon key）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...（service role key・サーバ専用）

# ----------------------------------------
# サイト/ブランディング（推奨）
# ----------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Gmail を開く際の受信アカウント（authuser）。未設定時は its@gw.8grp.co.jp
NEXT_PUBLIC_SOURCE_MAILBOX=its@gw.8grp.co.jp

# ----------------------------------------
# AI（任意・「✨AIで自動生成」「AIプロンプト」用）
#   未設定でも UI は動きます（コピペ方式の手動運用に切替）
# ----------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Anthropic 以外の汎用 LLM（OpenAI 互換 API など）を使う場合
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ----------------------------------------
# 外部連携（任意）
# ----------------------------------------
# 請求/書類サービス
BOARD_API_BASE=
BOARD_API_KEY=
BOARD_API_TOKEN=
# usage 集計エンドポイント (/api/usage) の受付トークン
USAGE_INGEST_TOKEN=
