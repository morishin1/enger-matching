# ENGER matching の環境変数サンプル
# 使い方:
#   1) このファイルを `.env.local` にコピー
#   2) 各キーの値を埋める（実値は Vercel 環境変数 / Supabase コンソールから取得）
#   3) `.env.local` は git 管理外（.gitignore 済）— コミットしないこと
#
# 種類:
#   NEXT_PUBLIC_* … ブラウザ側に露出する変数（公開鍵相当）
#   無印            … サーバ専用（service role key / API key など）

# ----------------------------------------
# Supabase（必須）
#   Project Settings → API から取得
# ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...（anon key）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...（service role key・サーバ専用）

# ----------------------------------------
# サイト/ブランディング（推奨）
# ----------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Gmail を開く際の受信アカウント（authuser）。未設定時は its@gw.8grp.co.jp
NEXT_PUBLIC_SOURCE_MAILBOX=its@gw.8grp.co.jp

# ----------------------------------------
# AI（任意・「✨AIで自動生成」「AIプロンプト」用）
#   未設定でも UI は動きます（コピペ方式の手動運用に切替）
# ----------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Anthropic 以外の汎用 LLM（OpenAI 互換 API など）を使う場合
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ----------------------------------------
# 外部連携（任意）
# ----------------------------------------
# 請求/書類サービス
BOARD_API_BASE=
BOARD_API_KEY=
BOARD_API_TOKEN=
# usage 集計エンドポイント (/api/usage) の受付トークン
USAGE_INGEST_TOKEN=
# エンド開拓リストへの自動追記 (/api/prospecting/ingest) の受付トークン
#   Claude Code の Routine / GitHub Actions から Authorization: Bearer <値> で叩く。
#   未設定なら CRON_SECRET を使う。どちらも無ければエンドポイントは 503（＝自動追記は無効）。
PROSPECTING_INGEST_TOKEN=
# 1回の自動追記で狙う件数（既定10）と、1回に受け付ける上限件数（既定50）
PROSPECTING_HOURLY_TARGET=10
PROSPECTING_INGEST_MAX=50
# Slack 通知（任意）。Incoming Webhook の URL。未設定なら通知は静かに skip。
#   応募登録時・企業の案件掲載申請時に社内チャンネルへ通知します。
SLACK_WEBHOOK_URL=

# ----------------------------------------
# メール送信 SMTP（差出人プロファイル別）
#   3 つの差出人を選べる:
#     - enger : enger.jp（Xserver 想定。SMTP_HOST/PORT を共有）
#     - 8grp  : 8grp.co.jp（同上）
#     - its   : its@gw.8grp.co.jp（Google Workspace。送信は Gmail の「送信済み」に自動保存）
#   未設定の差出人は UI 選択肢から自動的に消えます。
# ----------------------------------------
# 共通（enger / 8grp 用のフォールバック）
SMTP_HOST=
SMTP_PORT=465
# enger.jp
SMTP_ENGER_USER=
SMTP_ENGER_PASS=
SMTP_ENGER_FROM_NAME=
# 8grp.co.jp
SMTP_8GRP_USER=
SMTP_8GRP_PASS=
SMTP_8GRP_FROM_NAME=
# its@gw.8grp.co.jp（Google Workspace。要 2段階認証＋アプリパスワード）
#   既定: HOST=smtp.gmail.com, PORT=587
SMTP_ITS_HOST=smtp.gmail.com
SMTP_ITS_PORT=587
SMTP_ITS_USER=its@gw.8grp.co.jp
SMTP_ITS_PASS=
SMTP_ITS_FROM_NAME=its@gw.8grp.co.jp
